  "db_name": "PostgreSQL",
  "query": "\n        UPDATE public.vehicles SET\n            make         = COALESCE($1, make),\n            model        = COALESCE($2, model),\n            plate_number = COALESCE($3, plate_number),\n            year         = COALESCE($4, year),\n            vin          = COALESCE($5, vin),\n            fuel_type    = COALESCE($6, fuel_type)\n        WHERE id = $7\n        RETURNING\n            id,\n            owner_id,\n            make,\n            model,\n            plate_number,\n            year,\n            vin,\n            created_at,\n            archived_at,\n            $8 AS role,\n            NULL::TEXT AS \"contract_status?\",\n            fuel_type\n        ",
