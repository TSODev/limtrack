{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            v.id,\n            v.owner_id,\n            v.make,\n            v.model,\n            v.plate_number,\n            v.year,\n            v.vin,\n            v.created_at,\n            v.archived_at,\n            va.role,\n            NULL::TEXT AS \"contract_status?\",\n            v.fuel_type\n        FROM public.vehicles v\n        JOIN public.vehicle_access va\n          ON va.vehicle_id = v.id\n         AND va.user_id = $1\n        WHERE v.archived_at IS NOT NULL\n        ORDER BY v.archived_at DESC\n        ",
